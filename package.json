{
  "name": "cesta-k-jasliam",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Digitálna adventná duchovná cesta – Cesta k jasliam",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "validate": "node scripts/validate-content.mjs",
    "sources": "node scripts/build-sources.mjs",
    "scripture:fetch": "node scripts/fetch-scripture.mjs",
    "scripture:check": "node scripts/fetch-scripture.mjs --check",
    "dev": "npm run content && vite",
    "build": "npm run validate && npm run content && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "kkc:check": "node scripts/check-kkc.mjs",
    "pretest": "npm run content"
  },
  "dependencies": {
    "@fontsource-variable/literata": "^5.1.0",
    "@fontsource/cormorant-garamond": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8",
    "yaml": "^2.6.1"
  }
}
